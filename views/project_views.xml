<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Force module metadata used in Settings app list -->
    <record id="base.module_project" model="ir.module.module">
        <field name="shortdesc">Legal Practice Management</field>
        <field name="summary">Legal practice management for litigation cases and legal subjects.</field>
        <field name="icon">/legal_practice_management/static/description/icon.png</field>
    </record>

    <!-- Force app switcher label/icon on each module upgrade -->
    <record id="project.menu_main_pm" model="ir.ui.menu">
        <field name="name">Legal Practice Management</field>
        <field name="web_icon">legal_practice_management,static/description/icon.png</field>
    </record>

    <!-- Inherit the project.project form view to add legal case fields -->
    <record id="view_project_form_legal_case" model="ir.ui.view">
        <field name="name">project.project.form.legal.case</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//header//field[@name='stage_id']" position="attributes">
                <attribute name="domain">[('pipeline_type', '=', pipeline_type), '|', ('company_id', '=', False), ('company_id', '=?', company_id)]</attribute>
                <attribute name="context">{'pipeline_board_type': pipeline_type, 'default_pipeline_type': pipeline_type}</attribute>
            </xpath>
            <xpath expr="//page[@name='description']" position="before">
                <page string="Legal Case Details">
                    <group>
                        <group string="Case Identification">
                            <field name="pipeline_type" />
                            <field name="matter_type" />
                            <label for="office_file_number" />
                            <div class="o_row">
                                <field name="office_file_number"
                                    class="o_xxs_form_view"
                                    readonly="is_file_number_locked" />
                                <button name="action_get_next_office_file_number"
                                    type="object"
                                    class="btn btn-info"
                                    string="Get Next Number"
                                    invisible="office_file_number or is_file_number_locked"
                                    context="{'tracking_disable': True}"
                                    groups="base.group_user" />
                            </div>
                            <field name="court_name" />
                            <field name="court_circle" />
                            <field name="lawsuit_filing_date" />
                            <field name="first_degree_case_number_year" />
                            <field name="second_degree_case_number_year" />
                        </group>
                        <group string="Client Details">
                            <field name="client_status" />
                        </group>
                        <group string="Opponent Details">
                            <field name="opponent_status" />
                            <field name="opponent_name" />
                            <field name="opponent_address" />
                            <field name="opponent_phone" />
                            <field name="opponent_attorney_name" />
                            <field name="opponent_attorney_phone" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Disable quick create for project Kanban view -->
    <record id="view_project_kanban_disable_quick_create" model="ir.ui.view">
        <field name="name">project.project.kanban.disable.quick.create</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban" />
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="quick_create">false</attribute>
                <attribute name="on_create"></attribute>
            </xpath>
        </field>
    </record>


    <!-- Actions for different entity types -->
    <record id="action_view_legal_entities_all" model="ir.actions.act_window">
        <field name="name">All Legal Entities</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[("pipeline_type", "in", ["litigation", "legal_subject"]), ("is_template", "=", False)]</field>
        <!-- <field name="context">{}</field> -->
        <!-- Hide create button in legal entity kanban view -->
        <field name="context">{'group_by': 'stage_id', 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first legal entity!
            </p>
            <p>
                Create a new case or matter to start managing legal work.
            </p>
        </field>
    </record>

    <record id="action_view_legal_cases_all" model="ir.actions.act_window">
        <field name="name">Litigation Cases</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[("pipeline_type", "=", "litigation"), ("is_template", "=", False)]</field>
        <field name="context">{'group_by': 'stage_id', 'create_from_cases': True, 'pipeline_board_type': 'litigation', 'default_pipeline_type': 'litigation', 'default_matter_type': 'case'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first case!
            </p>
            <p>
                Create a new legal case to start managing court proceedings.
            </p>
        </field>
    </record>

    <record id="action_view_legal_matters_all" model="ir.actions.act_window">
        <field name="name">Legal Subjects</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[("pipeline_type", "=", "legal_subject"), ("is_template", "=", False)]</field>
        <field name="context">{'group_by': 'stage_id', 'create_from_matters': True, 'pipeline_board_type': 'legal_subject', 'default_pipeline_type': 'legal_subject', 'default_matter_type': 'subject'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first matter!
            </p>
            <p>
                Create a new matter to start managing legal work.
            </p>
        </field>
    </record>

    <record id="view_project_project_stage_form_pipeline" model="ir.ui.view">
        <field name="name">project.project.stage.form.pipeline</field>
        <field name="model">project.project.stage</field>
        <field name="inherit_id" ref="project.project_project_stage_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="before">
                <field name="pipeline_type" />
            </xpath>
        </field>
    </record>

    <record id="view_project_project_stage_tree_pipeline" model="ir.ui.view">
        <field name="name">project.project.stage.tree.pipeline</field>
        <field name="model">project.project.stage</field>
        <field name="inherit_id" ref="project.project_project_stage_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="pipeline_type" optional="show" />
            </xpath>
        </field>
    </record>

    <!-- Hiding Project Menu button "as it is already in configuration slide menu" -->
    <record id="project.menu_projects_group_stage" model="ir.ui.menu">
        <field name="active" eval="False" />
    </record>

    <!-- Legal Entities Menu -->
    <menuitem id="menu_legal_entities"
        name="All Legal Entities"
        parent="project.menu_main_pm"
        action="legal_practice_management.action_view_legal_entities_all"
        sequence="0" />

    <!-- Cases Menu -->
    <menuitem id="menu_cases"
        name="Litigation Cases"
        parent="project.menu_main_pm"
        action="legal_practice_management.action_view_legal_cases_all"
        sequence="0" />

    <!-- Matters Menu -->
    <menuitem id="menu_matters"
        name="Legal Subjects"
        parent="project.menu_main_pm"
        action="legal_practice_management.action_view_legal_matters_all"
        sequence="0" />
</odoo>
