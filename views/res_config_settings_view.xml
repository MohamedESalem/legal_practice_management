<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.legal_practice_management</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='project']" position="inside">
                <block title="Legal Practice Management Templates"
                    name="legal_practice_management_templates">
                    <setting id="legal_template_litigation"
                        string="Litigation Template"
                        help="Project template applied automatically when creating Litigation Cases.">
                        <field name="litigation_template_id"
                            placeholder="Select litigation template..." />
                        <div class="content-group mt16">
                            <div class="text-muted">
                                This template should include litigation-specific tasks such as
                                Filing, Discovery, Trial, Appeal and etc.
                            </div>
                        </div>
                    </setting>
                    <setting id="legal_template_subject"
                        string="Legal Subjects Template"
                        help="Project template applied automatically when creating Legal Subjects.">
                        <field name="advisory_template_id"
                            placeholder="Select legal subjects template..." />
                        <div class="content-group mt16">
                            <div class="text-muted">
                                This template should include legal-subject workflow tasks such as
                                Initial Consultation, Research, Drafting, Review and etc.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
